{
  "manifest_version": 2,
  "id": "github.fabiocsa.read-gif",
  "version": "0.2.3",
  "name": "GIF 动图识别（Read GIF）",
  "description": "采样 GIF / 动态 WebP / APNG，经宿主视觉模型生成描述；仅向 Planner/Replyer 提供有来源标识的派生上下文，支持按本轮历史消息精确关联，不改写原消息。",
  "author": {
    "name": "fabiocsa",
    "url": "https://github.com/fabiocsa"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/RoselindLabs/maibot-read-gif",
    "homepage": "https://github.com/fabiocsa/maibot-read-gif",
    "documentation": "https://github.com/RoselindLabs/maibot-read-gif/blob/main/README.md",
    "issues": "https://github.com/RoselindLabs/maibot-read-gif/issues"
  },
  "host_application": {
    "min_version": "1.3.19",
    "max_version": "999.999.999"
  },
  "sdk": {
    "min_version": "2.20.0",
    "max_version": "999.999.999"
  },
  "plugin_type": "media",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "film",
      "fallback": "images"
    }
  },
  "changelog": "CHANGELOG.md",
  "dependencies": [
    {
      "type": "python_package",
      "name": "Pillow",
      "version_spec": ">=10.0.0"
    }
  ],
  "capabilities": [
    "llm.generate"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
